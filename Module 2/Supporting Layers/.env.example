# Environment Variables - articles-api

# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must never be committed.

# Port the HTTP server listens on (default: 3000)
PORT=3000

# Runtime environment: development | test | production (default: development)
NODE_ENV=development

# Secret used to sign and verify JWTs (no default - required in production)
JWT_SECRET=your_jwt_secret_here

# Maximum number of articles allowed in the in-memory store (default: 50)
MAX_ARTICLES=50
